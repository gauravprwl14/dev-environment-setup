HASHNODE_API_KEY=your-personal-access-token-here
HASHNODE_PUBLICATION_ID=your-publication-id-here

# How to get these values:
#
# 1. HASHNODE_API_KEY (Personal Access Token):
#    - Log into Hashnode
#    - Go to Account Settings → Developer
#    - Click "Generate new token"
#    - Copy the token (treat it like a password)
#
# 2. HASHNODE_PUBLICATION_ID:
#    - Go to your blog's Dashboard
#    - Look at the URL: https://hashnode.com/{PUBLICATION_ID}/dashboard
#    - Copy the ID (looks like: 65d99cd9447d15d98a2fc264)
#
# Copy this file to your workspace root as .env and fill in your values.
